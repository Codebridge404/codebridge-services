# CodeBridges Production Docker Compose Interpolation Variables
COMPOSE_PROJECT_NAME=codebridge-prod

# Production Subdomains (*.servicefixit.me)
DOMAIN=servicefixit.me
FRONTEND_HOSTNAME=codebridge.servicefixit.me
API_HOSTNAME=codebridge-api.servicefixit.me
DOCS_HOSTNAME=codebridge-docs.servicefixit.me
CDN_HOSTNAME=codebridge-cdn.servicefixit.me
EVENTS_HOSTNAME=codebridge-events.servicefixit.me

# Secure Production MySQL Passwords (Never expose ports to public host!)
AUTH_MYSQL_ROOT_PASSWORD=prod_auth_root_secret_change_me_super_secure
AUTH_MYSQL_DATABASE=codebridge_auth_prod
AUTH_MYSQL_USER=codebridge_auth_prod_user
AUTH_MYSQL_PASSWORD=prod_auth_pass_change_me_super_secure

OPERATIONS_MYSQL_ROOT_PASSWORD=prod_ops_root_secret_change_me_super_secure
OPERATIONS_MYSQL_DATABASE=codebridge_operations_prod
OPERATIONS_MYSQL_USER=codebridge_ops_prod_user
OPERATIONS_MYSQL_PASSWORD=prod_ops_pass_change_me_super_secure

# Production Redis Passwords (Protected with AUTH)
AUTH_REDIS_PASSWORD=prod_auth_redis_secret_change_me_super_secure
OPERATIONS_REDIS_PASSWORD=prod_ops_redis_secret_change_me_super_secure

# Production MinIO S3 Credentials
MINIO_ROOT_USER=codebridge_prod_admin
MINIO_ROOT_PASSWORD=prod_minio_secret_change_me_super_secure
