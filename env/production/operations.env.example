APP_NAME="CodeBridge Operations Service"
APP_ENV=production
APP_KEY=base64:pRoD1uCt10nOpsK3yE4AmP1eS3cUr3S3cr3tF0rPr0d2026=
APP_DEBUG=false
APP_URL=https://codebridge-api.servicefixit.me
FRONTEND_URL=https://codebridge.servicefixit.me
API_BASE_URL=https://codebridge-api.servicefixit.me/api/v1
DOCS_URL=https://codebridge-docs.servicefixit.me
CDN_URL=https://codebridge-cdn.servicefixit.me
EVENTS_URL=https://codebridge-events.servicefixit.me

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=error

# Production MySQL Database (Internal Network Only)
DB_CONNECTION=mysql
DB_HOST=codebridge-operations-mysql-prod
DB_PORT=3306
DB_DATABASE=codebridge_operations_prod
DB_USERNAME=codebridge_ops_prod_user
DB_PASSWORD=prod_ops_pass_change_me_super_secure

# Production Redis (Internal Network Only with AUTH)
REDIS_CLIENT=phpredis
REDIS_HOST=codebridge-operations-redis-prod
REDIS_PASSWORD=prod_ops_redis_secret_change_me_super_secure
REDIS_PORT=6379

# Production Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailprovider.com
MAIL_PORT=587
MAIL_USERNAME=production_smtp_user
MAIL_PASSWORD=production_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@servicefixit.me"
MAIL_FROM_NAME="CodeBridge"

# Production MinIO S3 Object Storage
AWS_ACCESS_KEY_ID=codebridge_prod_admin
AWS_SECRET_ACCESS_KEY=prod_minio_secret_change_me_super_secure
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=codebridge-operations-prod
AWS_ENDPOINT=http://codebridge-minio-prod:9000
AWS_URL=https://codebridge-cdn.servicefixit.me/codebridge-operations-prod
AWS_USE_PATH_STYLE_ENDPOINT=true

# Stateless JWT Security
JWT_SECRET=production-jwt-secret-generate-with-openssl-rand-hex-32-for-security
JWT_ISSUER=codebridge-auth-service
JWT_ALGO=HS256

# Laravel Reverb WebSockets (Events)
REVERB_APP_ID=codebridge-prod-app
REVERB_APP_KEY=production-reverb-public-key
REVERB_APP_SECRET=production-reverb-secret-key-change-me
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=codebridge-events.servicefixit.me
REVERB_PORT=443
REVERB_SCHEME=https
