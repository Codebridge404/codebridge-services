# CodeBridges Staging Docker Compose Interpolation Variables
COMPOSE_PROJECT_NAME=codebridge-staging

# Subdomains & Hostnames (staging-*.servicefixit.me)
DOMAIN=servicefixit.me
FRONTEND_HOSTNAME=staging.codebridge.servicefixit.me
API_HOSTNAME=staging-codebridge-api.servicefixit.me
DOCS_HOSTNAME=staging-codebridge-docs.servicefixit.me
CDN_HOSTNAME=staging-codebridge-cdn.servicefixit.me
EVENTS_HOSTNAME=staging-codebridge-events.servicefixit.me

# Isolated Staging Database Credentials
AUTH_MYSQL_ROOT_PASSWORD=staging_auth_root_secret_change_me
AUTH_MYSQL_DATABASE=codebridge_auth_staging
AUTH_MYSQL_USER=codebridge_auth_user
AUTH_MYSQL_PASSWORD=staging_auth_pass_change_me

OPERATIONS_MYSQL_ROOT_PASSWORD=staging_ops_root_secret_change_me
OPERATIONS_MYSQL_DATABASE=codebridge_operations_staging
OPERATIONS_MYSQL_USER=codebridge_ops_user
OPERATIONS_MYSQL_PASSWORD=staging_ops_pass_change_me

# Staging Redis Passwords
AUTH_REDIS_PASSWORD=staging_auth_redis_secret_change_me
OPERATIONS_REDIS_PASSWORD=staging_ops_redis_secret_change_me

# Staging MinIO S3 Credentials
MINIO_ROOT_USER=codebridge_staging_admin
MINIO_ROOT_PASSWORD=staging_minio_secret_change_me
