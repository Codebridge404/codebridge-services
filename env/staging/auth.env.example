APP_NAME="CodeBridge Auth Service (Staging)"
APP_ENV=staging
APP_KEY=base64:sTaG1nGK3yE4AmP1eS3cUr3S3cr3tF0rS74g1nGt3st1n9=
APP_DEBUG=false
APP_URL=https://staging-codebridge-api.servicefixit.me
FRONTEND_URL=https://staging.codebridge.servicefixit.me
API_BASE_URL=https://staging-codebridge-api.servicefixit.me/api/v1
DOCS_URL=https://staging-codebridge-docs.servicefixit.me
CDN_URL=https://staging-codebridge-cdn.servicefixit.me
EVENTS_URL=https://staging-codebridge-events.servicefixit.me

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=info

# Isolated Staging MySQL
DB_CONNECTION=mysql
DB_HOST=codebridge-auth-mysql-staging
DB_PORT=3306
DB_DATABASE=codebridge_auth_staging
DB_USERNAME=codebridge_auth_user
DB_PASSWORD=staging_auth_pass_change_me

# Isolated Staging Redis
REDIS_CLIENT=phpredis
REDIS_HOST=codebridge-auth-redis-staging
REDIS_PASSWORD=staging_auth_redis_secret_change_me
REDIS_PORT=6379

# Staging Mail (Mailpit or Staging Sandbox SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smartpos-mailpit-staging
MAIL_PORT=1025
MAIL_FROM_ADDRESS="staging-noreply@servicefixit.me"
MAIL_FROM_NAME="CodeBridge Staging"

# Staging MinIO S3 Object Storage
AWS_ACCESS_KEY_ID=codebridge_staging_admin
AWS_SECRET_ACCESS_KEY=staging_minio_secret_change_me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=codebridge-auth-staging
AWS_ENDPOINT=http://codebridge-minio-staging:9000
AWS_URL=https://staging-codebridge-cdn.servicefixit.me/codebridge-auth-staging
AWS_USE_PATH_STYLE_ENDPOINT=true

# Stateless JWT Security
JWT_SECRET=staging-jwt-secret-at-least-64-characters-random-string-for-security
JWT_ISSUER=codebridge-auth-service
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=43200
JWT_ALGO=HS256

# Laravel Reverb WebSockets (Events)
REVERB_APP_ID=codebridge-staging-app
REVERB_APP_KEY=staging-reverb-public-key
REVERB_APP_SECRET=staging-reverb-secret-key-change-me
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=staging-codebridge-events.servicefixit.me
REVERB_PORT=443
REVERB_SCHEME=https

