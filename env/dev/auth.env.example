APP_NAME="CodeBridge Auth Service (Dev)"
APP_ENV=local
APP_KEY=base64:3B7f8z7tQ3n8QfV+M1s2rL4jH9u8P+W3xZ5yT6aB7c0=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/v1
DOCS_URL=http://localhost:8080/docs
CDN_URL=http://localhost:9000
EVENTS_URL=http://localhost:8080

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug
TELEMETRY_ENABLED=true
TELEMETRY_SLOW_QUERY_MS=100
TELEMETRY_SLOW_REQUEST_MS=250
TELEMETRY_EMIT_ALL_REQUESTS=false

DB_CONNECTION=mysql
DB_HOST=codebridge-auth-mysql
DB_PORT=3306
DB_DATABASE=codebridge_auth
DB_USERNAME=root
DB_PASSWORD=root_password

CACHE_STORE=redis
CACHE_PREFIX=codebridge-dev-auth-
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=codebridge-auth-redis
REDIS_PORT=6379
REVOCATION_ENABLED=true
REVOCATION_REDIS_HOST=codebridge-auth-redis
REVOCATION_REDIS_PORT=6379
REVOCATION_REDIS_DB=2
REVOCATION_REDIS_PREFIX=cb-revocation:

MAIL_MAILER=smtp
MAIL_HOST=smartpos-mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@codebridge.dev"
MAIL_FROM_NAME="CodeBridge Dev"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=codebridge-auth
AWS_ENDPOINT=http://codebridge-minio:9000
AWS_URL=http://localhost:9000/codebridge-auth
AWS_USE_PATH_STYLE_ENDPOINT=true

JWT_SECRET=dev-secret-key-32-characters-minimum-for-local-testing
JWT_ISSUER=codebridge-auth-service
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=43200
JWT_ALGO=HS256

REVERB_APP_ID=codebridge-dev-app
REVERB_APP_KEY=codebridge-dev-key
REVERB_APP_SECRET=codebridge-dev-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

