# ==============================================================================
# DEMO / STAGING VPS ENVIRONMENT
# ==============================================================================
APP_NAME="CodeBridges Auth (Demo)"
APP_ENV=demo
APP_KEY=base64:7GZ5+uQ/s7N3xLgW+tEw1PqY7UoVn9iKm4jRt2v8xLg=
APP_DEBUG=true
APP_URL=http://localhost:8080

COMPOSE_PROFILES=demo
HTTP_PORT=8080

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=auth-mysql
DB_PORT=3306
DB_DATABASE=codebridge_auth
DB_USERNAME=codebridge_auth
DB_PASSWORD=codebridge_auth_demo_secret

# Redis Configuration
REDIS_HOST=auth-redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Cache, Session, Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# JWT Secret (>= 32 chars)
JWT_SECRET=demo_codebridge_auth_service_secure_token_secret_string_32chars!
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=43200

# MinIO S3 Storage
FILESYSTEM_DISK=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=codebridge-auth
MINIO_URL=http://localhost:9000/codebridge-auth

# Mailpit (SMTP Mock for Demo)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="demo@codebridge.local"
MAIL_FROM_NAME="CodeBridges Demo"

