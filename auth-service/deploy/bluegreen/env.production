# ==============================================================================
# PRODUCTION VPS ENVIRONMENT (Hardened)
# ==============================================================================
APP_NAME="CodeBridges Auth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://auth.yourdomain.com

COMPOSE_PROFILES=production
HTTP_PORT=80

# Production Database (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=auth-mysql
DB_PORT=3306
DB_DATABASE=codebridge_auth
DB_USERNAME=codebridge_auth
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD_64_CHARS
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_ROOT_PASSWORD_64_CHARS
MYSQL_BIND_PORT=127.0.0.1:3307

# Production Redis (Redis 8)
REDIS_HOST=auth-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_REDIS_PASSWORD_64_CHARS
REDIS_BIND_PORT=127.0.0.1:6379

# Cache, Session, Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Production JWT Secret (Strictly required >= 32 chars)
JWT_SECRET=GENERATE_64_CHAR_HEX_STRING_HERE_FOR_PRODUCTION_JWT_SECRET
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=43200
JWT_ISSUER=codebridge-auth-service

# Production MinIO / S3 Storage
FILESYSTEM_DISK=minio
MINIO_ROOT_USER=codebridge_s3_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_MINIO_PASSWORD_64_CHARS
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=codebridge-auth
MINIO_URL=https://storage.yourdomain.com/codebridge-auth

# Production Mail Driver (SES / SendGrid / Postmark / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_production_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="CodeBridges Identity"

