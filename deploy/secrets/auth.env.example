# kubectl --from-env-file format: do not quote values; never source this file.
# Keep the existing APP_KEY and JWT_SECRET for an existing deployment.
APP_KEY=REPLACE_WITH_EXISTING_OR_NEW_BASE64_KEY
JWT_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
DB_HOST=REPLACE_WITH_PRIVATE_HOST_REACHABLE_FROM_PODS
DB_PORT=3307
DB_DATABASE=REPLACE_WITH_AUTH_DATABASE
DB_USERNAME=REPLACE_WITH_AUTH_APP_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_HOST=REPLACE_WITH_PRIVATE_HOST_REACHABLE_FROM_PODS
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=REPLACE_WITH_SENDER_EMAIL
MAIL_FROM_NAME=CodeBridge
