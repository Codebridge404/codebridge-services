# Use a separate APP_KEY and database; JWT_SECRET must match Auth.
APP_KEY=REPLACE_WITH_EXISTING_OR_NEW_BASE64_KEY
JWT_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
DB_HOST=REPLACE_WITH_PRIVATE_HOST_REACHABLE_FROM_PODS
DB_PORT=3308
DB_DATABASE=REPLACE_WITH_OPERATIONS_DATABASE
DB_USERNAME=REPLACE_WITH_OPERATIONS_APP_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_HOST=REPLACE_WITH_PRIVATE_HOST_REACHABLE_FROM_PODS
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# Existing Operations config includes an auth_db connection. Use least privilege.
AUTH_DB_HOST=REPLACE_WITH_PRIVATE_AUTH_DATABASE_HOST
AUTH_DB_PORT=3307
AUTH_DB_DATABASE=REPLACE_WITH_AUTH_DATABASE
AUTH_DB_USERNAME=REPLACE_WITH_AUTH_DATABASE_ACCESS_USER
AUTH_DB_PASSWORD=REPLACE_WITH_AUTH_DATABASE_ACCESS_PASSWORD
