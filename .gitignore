# OS & IDE System Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp

# Environment & Secrets (Ignored across all microservices)
.env
.env.*
!.env.example
env/**/*.env
!env/**/*.env.example

# Kubernetes Secrets
secrets.yaml
**/secrets.yaml
k8s/**/secrets.yaml
!k8s/**/secrets.example.yaml
!**/secrets.example.yaml

# Composer & Node Dependencies
**/vendor/
**/node_modules/

# Build & Output Artifacts
**/build/
**/.next/
**/out/
*.tsbuildinfo

# Logs & Framework Caches
*.log
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/framework/testing/*
**/bootstrap/cache/*

# Nginx Proxy Manager Data & SSL Certificates
nginx-proxy-manager/data/
nginx-proxy-manager/letsencrypt/
**/data/
**/letsencrypt/

# Database & System Backups
backups/
*.sql.gz
*.tar.gz

# Kubernetes Secrets & Credentials
secrets.yaml
**/secrets.yaml
!**/secrets.example.yaml
